generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  name         String?
  passwordHash String
  currency     String            @default("XOF")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  bets         Bet[]
  betSlips     BetSlip[]
  coupons      Coupon[]
  sessions     Session[]
  wallet       Wallet?
  transactions WalletTransaction[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal  @db.Decimal(18, 2)
  balanceAfter Decimal @db.Decimal(18, 2)
  reference   String?  @unique
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Match {
  id          Int          @id @default(autoincrement())
  externalId  String?      @unique
  homeTeam    String
  awayTeam    String
  date        DateTime
  league      String
  status      String       @default("scheduled")
  homeScore   Int?
  awayScore   Int?
  bets        Bet[]
  betSelections BetSelection[]
  predictions Prediction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([date])
  @@index([status, date])
}

model BetSlip {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  stake        Decimal        @db.Decimal(18, 2)
  totalOdds    Decimal        @db.Decimal(12, 4)
  potentialWin Decimal        @db.Decimal(18, 2)
  status       String         @default("pending")
  settledAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  selections   BetSelection[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BetSelection {
  id         Int      @id @default(autoincrement())
  betSlipId  Int
  betSlip    BetSlip  @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  matchId    Int
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  market     String
  choice     String
  odds       Decimal  @db.Decimal(12, 4)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([betSlipId])
  @@index([matchId, status])
}

model Bet {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  matchId      Int
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(18, 2)
  odds         Decimal  @db.Decimal(12, 4)
  potentialWin Decimal  @db.Decimal(18, 2)
  selection    String
  status       String   @default("pending")
  settledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([matchId, status])
}

model Prediction {
  id         Int      @id @default(autoincrement())
  matchId    Int
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  prediction String
  confidence Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([matchId])
}

model Coupon {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  code       String   @unique
  selections Json
  stake      Decimal  @default(0) @db.Decimal(18, 2)
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}
